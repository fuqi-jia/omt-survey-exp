(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 (- 4)))
(assert (<= x0 4))
(declare-fun x1 () Real)
(assert (>= x1 1))
(assert (<= x1 2))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= x2 16))
(assert (>= (+ 0 (* 1 x2) (* (- 1) x0 x0)) 0))
(assert (<= (+ 0 (* 1 x2) (* (- 1) x0 x0)) 0))
(assert (<= (+ 9 (* 1 x2 x2) (* (- 6) x2) (* 1 x1 x1)) 3))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x0) (* (/ 1 10) x1))))
(minimize (+ obj 0))
(check-sat)
(set-option :pp.decimal false)
(get-objectives)
(set-option :pp.decimal true)
(get-value (x0 x1 x2))
