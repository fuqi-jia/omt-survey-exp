(set-option :produce-models true)
(set-logic OMT_QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 (- 4)))
(assert (<= x0 4))
(declare-fun x1 () Real)
(assert (>= x1 1))
(assert (<= x1 3))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= x2 16))
(assert (>= (+ 0 (* 1 x2) (* (- 1) x0 x0)) 0))
(assert (<= (+ 0 (* 1 x2) (* (- 1) x0 x0)) 0))
(assert (<= (+ 16 (* 1 x2 x2) (* (- 8) x2) (* 1 x1 x1)) 6))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x0) (* (/ 1 10) x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
