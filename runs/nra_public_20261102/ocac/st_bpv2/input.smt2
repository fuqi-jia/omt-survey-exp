(set-option :produce-models true)
(set-logic OMT_QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 4))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 4))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= x2 5))
(declare-fun x3 () Real)
(assert (>= x3 0))
(assert (<= x3 5))
(assert (>= (+ 0 (* (- 4) x0) (* (- 1) x1)) (- 12)))
(assert (>= (+ 0 (* 3 x0) (* (- 1) x1)) (- 1)))
(assert (<= (+ 0 (* 4 x2) (* (- 1) x3)) 12))
(assert (>= (+ 0 (* (- 1) x2) (* (- 1) x3)) (- 8)))
(assert (>= (+ 0 (* 4 x2) (* (- 1) x3)) (- 1)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x1) (* 1 x2) (* (- 1) x0 x2) (* 1 x1 x2))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
