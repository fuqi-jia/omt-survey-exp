(set-option :produce-models true)
(set-logic OMT_QF_NRA)
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(assert (>= x1 0))
(declare-fun x2 () Real)
(assert (<= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x2)) 0))
(assert (<= (+ 0 (* (- 1) x0) (* 1 x1) (* (- 1) x2)) 0))
(assert (<= (+ 0 (* 12 x0) (* 5 x1) (* 12 x2)) (/ 114 5)))
(assert (<= (+ 0 (* 12 x0) (* 12 x1) (* 7 x2)) (/ 171 10)))
(assert (<= (+ 0 (* (- 6) x0) (* 1 x1) (* 1 x2)) (/ 19 10)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x2) (* (- 1) x0 x0) (* (- 1) x1 x1) (* (- 1) x2 x2))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
