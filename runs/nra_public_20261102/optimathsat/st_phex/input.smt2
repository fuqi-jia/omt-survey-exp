(set-option :produce-models true)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= (+ 0 (* 1 x0) (* 1 x1)) 10))
(assert (<= (+ 0 (* 1 x0) (* 5 x1)) 22))
(assert (<= (+ 0 (* (- 3) x0) (* 2 x1)) 2))
(assert (<= (+ 0 (* (- 1) x0) (* (- 4) x1)) (- 4)))
(assert (<= (+ 0 (* 1 x0) (* (- 2) x1)) 4))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* (- 1) x0 x0) (* (- 4) x1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1))
