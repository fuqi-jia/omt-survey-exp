(set-option :produce-models true)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 4))
(declare-fun x1 () Real)
(assert (>= x1 1))
(assert (<= x1 5))
(assert (>= (+ 0 (* 2 x0) (* 3 x1)) 9))
(assert (<= (+ 0 (* 3 x0) (* (- 1) x1)) 8))
(assert (<= (+ 0 (* (- 1) x0) (* 2 x1)) 8))
(assert (<= (+ 0 (* 1 x0) (* 2 x1)) 12))
(declare-fun obj () Real)
(assert (= obj (+ (- 5) (* 5 x0) (* 6 x1) (* 1 x0 x0) (* (- 1) x1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1))
