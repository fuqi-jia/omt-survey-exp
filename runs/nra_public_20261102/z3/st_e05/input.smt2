(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 15834))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 36250))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= x2 10000))
(declare-fun x3 () Real)
(assert (>= x3 100))
(assert (<= x3 300))
(declare-fun x4 () Real)
(assert (>= x4 100))
(assert (<= x4 400))
(assert (>= (+ 0 (* (- 36000) x0) (* 100000 x3) (* 120 x0 x3)) 10000000))
(assert (<= (+ 0 (* (- 36000) x0) (* 100000 x3) (* 120 x0 x3)) 10000000))
(assert (>= (+ 0 (* (- 32000) x1) (* (- 100000) x3) (* 100000 x4) (* 80 x1 x4)) 0))
(assert (<= (+ 0 (* (- 32000) x1) (* (- 100000) x3) (* 100000 x4) (* 80 x1 x4)) 0))
(assert (>= (+ 0 (* (- 4000) x2) (* (- 100000) x4)) (- 50000000)))
(assert (<= (+ 0 (* (- 4000) x2) (* (- 100000) x4)) (- 50000000)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x0) (* 1 x1) (* 1 x2))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3 x4))
