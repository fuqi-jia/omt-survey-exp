(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (>= (+ 0 (* 1 x0) (* (- 4) x1)) (- 8)))
(assert (>= (+ 0 (* (- 3) x0) (* 1 x1)) (- 9)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x0) (* 4 x1) (* (- 1) x0 x0) (* (- 1) x1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1))
