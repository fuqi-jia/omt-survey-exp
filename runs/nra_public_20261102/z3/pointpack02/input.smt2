(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 (/ 1 2)))
(assert (<= x0 1))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 1))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= x2 1))
(declare-fun x3 () Real)
(assert (>= x3 0))
(assert (<= x3 1))
(declare-fun x4 () Real)
(assert (<= (+ 0 (* 1 x4) (* (- 1) x0 x0) (* 2 x0 x1) (* (- 1) x1 x1) (* (- 1) x2 x2) (* 2 x2 x3) (* (- 1) x3 x3)) 0))
(assert (<= (+ 0 (* (- 1) x2) (* 1 x3)) 0))
(assert (<= (+ 0 (* (- 1) x0) (* 1 x1)) 0))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x4))))
(maximize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3 x4))
