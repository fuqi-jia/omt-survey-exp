(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 (- 10)))
(assert (<= x0 5))
(declare-fun x1 () Real)
(assert (>= x1 (- 10)))
(assert (<= x1 20))
(declare-fun x2 () Real)
(declare-fun x3 () Real)
(assert (<= (+ 0 (* 2 x0) (* 1 x1)) 14))
(assert (<= (+ 0 (* 1 x0) (* 1 x1)) 10))
(assert (<= (+ 0 (* (- 4) x0) (* 1 x1)) 0))
(assert (<= (+ 0 (* (- 2) x0) (* (- 1) x1)) (- 6)))
(assert (<= (+ 0 (* (- 1) x0) (* (- 2) x1)) (- 6)))
(assert (<= (+ 0 (* 1 x0) (* (- 1) x1)) 3))
(assert (>= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x2)) 0))
(assert (<= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x2)) 0))
(assert (>= (+ 0 (* 1 x0) (* (- 1) x1) (* (- 1) x3)) (- 7)))
(assert (<= (+ 0 (* 1 x0) (* (- 1) x1) (* (- 1) x3)) (- 7)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x2 x3))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3))
