(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 7))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 6))
(declare-fun x2 () Real)
(declare-fun x3 () Real)
(declare-fun x4 () Real)
(assert (<= (+ 0 (* 1 x0) (* (- 2) x1)) 100))
(assert (<= (+ 0 (* (- 1) x0) (* (- 2) x1)) 100))
(assert (>= (+ 0 (* (- 1) x0) (* 2 x1)) 5))
(assert (<= (+ 0 (* (- 1) x0) (* 2 x1)) 8))
(assert (<= (+ 0 (* 1 x0) (* 2 x1)) 12))
(assert (>= (+ 0 (* 1 x0) (* (- 1) x2)) 0))
(assert (<= (+ 0 (* 1 x0) (* (- 1) x2)) 0))
(assert (>= (+ 0 (* 2 x0) (* (- 3) x1) (* (- 1) x3)) (- 13)))
(assert (<= (+ 0 (* 2 x0) (* (- 3) x1) (* (- 1) x3)) (- 13)))
(assert (>= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x4)) 1))
(assert (<= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x4)) 1))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x2) (* 1 x3 x4))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3 x4))
