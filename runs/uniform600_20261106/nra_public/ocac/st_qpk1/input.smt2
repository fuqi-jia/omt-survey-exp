(set-option :produce-models true)
(set-logic OMT_QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= (+ 0 (* (- 1) x0) (* 1 x1)) 1))
(assert (<= (+ 0 (* 1 x0) (* (- 1) x1)) 1))
(assert (<= (+ 0 (* (- 1) x0) (* 2 x1)) 3))
(assert (<= (+ 0 (* 2 x0) (* (- 1) x1)) 3))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x0) (* 3 x1) (* (- 2) x0 x0) (* 2 x0 x1) (* (- 2) x1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
