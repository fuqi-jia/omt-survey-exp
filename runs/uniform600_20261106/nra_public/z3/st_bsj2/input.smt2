(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(declare-fun x2 () Real)
(assert (>= x2 0))
(assert (<= (+ 0 (* 1 x0) (* 1 x1) (* (- 1) x2)) 1))
(assert (<= (+ 0 (* (- 1) x0) (* 1 x1) (* (- 1) x2)) (- 1)))
(assert (<= (+ 0 (* 12 x0) (* 5 x1) (* 12 x2)) (/ 174 5)))
(assert (<= (+ 0 (* 12 x0) (* 12 x1) (* 7 x2)) (/ 291 10)))
(assert (<= (+ 0 (* (- 6) x0) (* 1 x1) (* 1 x2)) (- (/ 41 10))))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x0) (* 2 x2) (* (- 1) x0 x0) (* (- 1) x1 x1) (* (- 1) x2 x2))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2))
