(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 3))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 2))
(assert (<= (+ 0 (* (- 2) x0) (* 1 x1)) 1))
(assert (<= (+ 0 (* 1 x0) (* 1 x1)) 4))
(assert (<= (+ 0 (* (/ 1 2) x0) (* (- 1) x1)) 1))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* (/ 12 5) x0) (* (/ 6 5) x1) (* (- 1) x0 x0) (* (- 1) x1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1))
