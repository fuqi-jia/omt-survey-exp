(set-option :produce-models true)
(set-option :pp.decimal true)
(set-option :pp.decimal_precision 20)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(declare-fun x2 () Real)
(assert (>= x2 0))
(declare-fun x3 () Real)
(assert (>= x3 0))
(declare-fun x4 () Real)
(assert (>= x4 0))
(assert (>= (+ 0 (* 1 x0)) 1))
(assert (<= (+ 0 (* 1 x0)) 1))
(assert (>= (+ 0 (* 1 x1)) 1))
(assert (<= (+ 0 (* 1 x1)) 1))
(assert (>= (+ 0 (* 1 x2)) 1))
(assert (<= (+ 0 (* 1 x2)) 1))
(assert (>= (+ 0 (* 1 x3)) 1))
(assert (<= (+ 0 (* 1 x3)) 1))
(assert (>= (+ 0 (* 1 x4)) 1))
(assert (<= (+ 0 (* 1 x4)) 1))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x0 x2) (* 4 x0 x3) (* 3 x0 x4) (* 6 x1 x2) (* 2 x1 x3) (* 3 x1 x4) (* 5 x2 x3) (* 3 x2 x4) (* 3 x3 x4))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3 x4))
