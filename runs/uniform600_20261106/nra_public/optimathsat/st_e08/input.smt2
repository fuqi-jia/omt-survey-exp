(set-option :produce-models true)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(assert (<= x0 1))
(declare-fun x1 () Real)
(assert (>= x1 0))
(assert (<= x1 1))
(assert (<= (+ 0 (* (- 16) x0 x1)) (- 1)))
(assert (<= (+ 0 (* (- 4) x0 x0) (* (- 4) x1 x1)) (- 1)))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 2 x0) (* 1 x1))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1))
