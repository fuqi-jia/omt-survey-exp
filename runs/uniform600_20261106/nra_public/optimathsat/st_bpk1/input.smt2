(set-option :produce-models true)
(set-logic QF_NRA)
(declare-fun x0 () Real)
(assert (>= x0 0))
(declare-fun x1 () Real)
(assert (>= x1 0))
(declare-fun x2 () Real)
(assert (>= x2 0))
(declare-fun x3 () Real)
(assert (>= x3 0))
(assert (<= (+ 0 (* 1 x0) (* 4 x1)) 8))
(assert (<= (+ 0 (* 4 x0) (* 1 x1)) 12))
(assert (<= (+ 0 (* 3 x0) (* 4 x1)) 12))
(assert (<= (+ 0 (* 2 x2) (* 1 x3)) 8))
(assert (<= (+ 0 (* 1 x2) (* 2 x3)) 8))
(assert (<= (+ 0 (* 1 x2) (* 1 x3)) 5))
(declare-fun obj () Real)
(assert (= obj (+ 0 (* 1 x0) (* (- 1) x1) (* (- 1) x2) (* (- 1) x0 x2) (* 1 x0 x3) (* 1 x1 x2) (* (- 1) x1 x3))))
(minimize (+ obj 0))
(check-sat)
(get-objectives)
(get-value (x0 x1 x2 x3))
